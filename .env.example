# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# --- AI receipt parsing ---
# You don't have to set these here at all — the easier way is to run the app
# and add your API key on the Settings page (/settings), which works for
# whoever is actually using this build regardless of which provider they use.
# These env vars are just a fallback/default if you'd rather set it once here.
#
# AI_PROVIDER=anthropic          # or: openai
# ANTHROPIC_API_KEY=             # from https://console.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY=                # from https://platform.openai.com
# OPENAI_MODEL=gpt-4o

# --- Data backend ---
# The easiest way to choose/switch this is the Settings page in the app
# itself (http://localhost:3000/settings) — no file editing needed, and it
# takes effect immediately, no restart. These env vars are just a one-time
# fallback/default, and (for Supabase) a way to pre-fill it before the app
# has even run once.
#
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_KEY=                  # the "anon" / "publishable" key, not the service_role key

# --- Google Drive (optional cloud storage option) ---
# This lets whoever uses the app click "Connect Google Drive" on the
# Settings page and sign in with their own Google account — no project URL
# or key for them to handle. But someone has to create these two values
# ONCE, for the app itself, first. See "Turning on the Google Drive option"
# in README.md for the five-minute Google Cloud Console steps.
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Only needed if you're not running this on localhost:3000 — must exactly
# match a redirect URI registered on the OAuth client in Google Cloud.
# GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# --- Sign-in (required — the app won't let anyone in without this) ---
# Buildscope requires signing in with Google or Apple; each signed-in
# person gets their own separate account/build, invisible to everyone
# else. At least one of the two providers below needs to be set up.
#
# Google reuses the same GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET as the
# Google Drive option above (Google lets one OAuth client ask for
# different scopes on different requests) — if you've already set those
# up for Drive, Google sign-in works with no extra Cloud Console steps.
# You do need to add ONE more Authorized redirect URI on that same OAuth
# client in Google Cloud Console: <your domain>/auth/google/callback
# (this is different from /oauth/google/callback, which is Drive-specific).
#
# GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Apple Sign-In needs its own one-time setup in Apple's developer portal —
# see "Turning on Apple Sign-In" in README.md for the exact steps. All
# four of these have to be set together or Apple sign-in stays hidden.
#
# APPLE_TEAM_ID=
# APPLE_SERVICES_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=             # full contents of the .p8 file, as one value
# APPLE_LOGIN_REDIRECT_URI=http://localhost:3000/auth/apple/callback

# --- Xero accounting sync (optional) ---
# Lets whoever uses the app click "Connect Xero" on the Settings page and
# push a transaction straight into Xero as a bill. Someone has to create
# these two values ONCE for the app itself, in a free Xero Developer
# account. See "Turning on the Xero accounting sync option" in README.md.
#
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# Only needed if you're not running this on localhost:3000 — must exactly
# match a redirect URI registered on the app in the Xero Developer portal.
# XERO_REDIRECT_URI=http://localhost:3000/oauth/xero/callback
# Which account code Xero bills get coded to if this install hasn't told
# it otherwise — has to already exist in your Xero chart of accounts.
# XERO_DEFAULT_ACCOUNT_CODE=429

# Optional — defaults to 3000 if not set.
# PORT=3000
